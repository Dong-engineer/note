<model>
<Core:StyleSheet id="58d6989a-66f8-11ec-b4c8-0456e5e540ed">
<styleSheet>
<val>diagram {
 /* line-style: sloppy 0.3; */
}

lifeline[name="New Lifeline"] {
  background-color: rgba(119, 118, 123, 1.0);
}

lifeline[name="未修改文件"] {
  background-color: rgba(119, 118, 123, 1.0);
}

lifeline[name="未跟踪文件"] {
  background-color: rgba(85, 85, 85, 1.0);
}

lifeline[name="未修改文件"] {
  background-color: rgba(28, 113, 216, 1.0);
}

lifeline[name="已修改文件"] {
  background-color: rgba(229, 165, 10, 1.0);
}

lifeline[name="New Lifeline"] {
  background-color: rgba(198, 70, 0, 1.0);
}

lifeline[name="已暂存文件"] {
  background-color: rgba(198, 70, 0, 1.0);
}
</val>
</styleSheet>
</Core:StyleSheet>
